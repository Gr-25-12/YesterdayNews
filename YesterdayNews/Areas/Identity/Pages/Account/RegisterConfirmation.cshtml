@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register Confirmation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-3">
                    <div class="confirmation-icon mb-3">
                        <i class="fas fa-envelope-circle-check fa-3x"></i>
                    </div>
                    <h1 class="h2 mb-0 fw-bold">@ViewData["Title"]</h1>
                </div>

                <div class="card-body p-5">
                    
                    
                        <div class="text-center mb-4">
                            <div class="alert alert-info rounded-3" role="alert">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Almost there!</strong> One more step to activate your account.
                            </div>
                        </div>

                        <div class="text-center">
                            <p class="text-muted mb-4">
                                Welcome to our community! To complete your registration and start reading all the old news,
                                please check you email address and confirm your email.
                            </p>
                            <div class="alert alert-warning rounded-3 mt-4" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <small>
                                    <strong>Note:</strong> Temp and dummy emails will work 😅.
                                    if you can't find the email? Check your spam folder
                                    or wait a few minutes for it to arrive.
                                    
                                </small>
                            </div>
                        </div>
                   
                </div>

                <div class="card-footer bg-light text-center py-3 rounded-bottom-3">
                    <small class="text-muted">
                        Need help? <a href="/Home/Privacy" class="text-decoration-none">Contact our support team if you ound them or check our T&C</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>


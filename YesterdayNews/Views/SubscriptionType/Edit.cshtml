@model YesterdayNews.Models.Db.SubscriptionType

@{
    ViewData["Title"] = "Edit Subscription Plan";
}

<div class="mt-3 d-flex justify-content-end">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="container col-lg-6 col-md-8 col-12">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-primary py-3">
            <h5 class="text-white mb-0 text-center">Edit Subscription Plan</h5>
        </div>

        <div class="card-body p-4">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group mb-3">
                            <label for="TypeName" class="form-label">Plan Name</label>
                            <input asp-for="TypeName" class="form-control" />
                            <span asp-validation-for="TypeName" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Price" class="form-label">Price</label>
                            <input asp-for="Price"
                                   type="number"
                                   min="0"
                                   inputmode="decimal"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="form-group text-center">
                            <input type="submit" value="Save" class="btn btn-primary px-4" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
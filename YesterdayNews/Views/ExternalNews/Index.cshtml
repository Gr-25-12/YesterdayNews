                            </svg>
                        </div>
                    </div>
                    <!-- The Guardian -->
                    <div class="col-auto">
                        <div class="partner-icon" data-bs-toggle="tooltip" title="The Guardian">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="100" height="100" viewBox="0 0 50 50">
                                <path d="M 25 2 C 12.309534 2 2 12.309534 2 25 C 2 37.690466 12.309534 48 25 48 C 37.690466 48 48 37.690466 48 25 C 48 12.309534 37.690466 2 25 2 z M 25 4 C 36.609534 4 46 13.390466 46 25 C 46 36.609534 36.609534 46 25 46 C 13.390466 46 4 36.609534 4 25 C 4 13.390466 13.390466 4 25 4 z M 26.679688 7.015625 C 24.179688 7.015625 9.9445156 7.6365 8.4785156 21.6875 C 8.3255156 23.1515 8.3645156 26.107219 8.4785156 27.574219 C 8.9405156 33.530219 10.824734 42.607422 27.052734 42.607422 L 27.052734 41.697266 C 27.052734 41.697266 19.871172 40.547547 19.201172 30.685547 C 19.029172 28.154547 19.201172 23.074109 19.201172 20.537109 C 19.201172 19.821109 19.392734 7.9941406 27.052734 7.9941406 L 27.052734 7.0214844 C 27.052734 7.0214844 26.921688 7.014625 26.679688 7.015625 z M 28.648438 7.0214844 L 28.648438 7.8828125 L 36.021484 17.871094 L 36.818359 17.871094 L 36.818359 10.978516 C 36.818359 10.979516 32.988437 7.3724844 28.648438 7.0214844 z M 26.095703 25.371094 L 26.095703 26.089844 L 28.585938 26.951172 L 28.585938 42.080078 C 28.585938 42.080078 34.042906 40.452297 36.628906 38.154297 L 36.628906 27.048828 L 38.925781 26.138672 L 38.925781 25.371094 L 26.095703 25.371094 z"></path>
                            </svg>
                        </div>
                    </div>
                    <!-- New York Times -->
                    <div class="col-auto">
                        <div class="partner-icon" data-bs-toggle="tooltip" title="New York Times">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="100" height="100" viewBox="0 0 48 48">
                                <path d="M45,12v24c0,4.962-4.037,9-9,9H12c-4.963,0-9-4.038-9-9V12c0-4.962,4.037-9,9-9h24C40.963,3,45,7.038,45,12z M31.39,26.282	l1.74-1.414v-0.161l-1.74-1.414v-6.056c1.931-0.394,3.591-1.768,3.591-4.285C34.98,9.772,31.959,9,29.574,9v2	c1.049,0,2.126,0.132,2.126,0.9c0,0.636-0.592,0.734-1.49,0.734c-1.113,0-3.499-0.636-5.248-1.272	c-2.067-0.795-3.976-1.431-5.566-1.431c-3.18,0-5.407,2.385-5.407,5.089c0,2.385,1.749,3.18,2.385,3.499l1.098-1.572	c0,0-1.386-0.461-1.386-1.353c0-0.861,0.881-1.192,1.878-1.192c1.431,0,3.34,1.097,5.884,1.892c2.045,0.584,4.214,0.87,5.541,1.036	v5.872l-1.74,1.508v0.161l1.74,1.508v7.387c-3.072,1.876-7.015,0.858-9.042-0.925l5.547-2.706L26,30.097V19.094l-0.036,0.019v-0.019	l-7.72,3.386C19.002,20.864,20.453,19.287,23,18l-0.837-1.515c-4.797,1.279-9.114,5.758-9.114,11.198	c0,6.394,5.277,11.198,11.198,11.198c6.394,0,10.555-5.122,10.555-10.399H33c-0.394,1.41-0.949,2.539-1.61,3.432V26.282z M21.385,23.103v7.229l-2.183,1.065c-0.46-0.69-1.987-3.513-1.608-6.631L21.385,23.103z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="col-auto mt-5">
                        <div class="partner-icon" data-bs-toggle="tooltip" title="SEBY NEWS">
                            <img src="~/SEBY NEWS.png" alt="SEBY" width="100" height="70" />
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="mb-5">
            <div class="d-flex align-items-center mb-3">
                <h3 class="mb-0 border-bottom pb-2 flex-grow-1">
                    <i class="fas fa-star me-2"></i>SEBY News
                </h3>
                <span class="badge bg-secondary ms-3">@((ViewBag.SebyNews as List<ExternalNewsVMSEBY>)?.Count ?? 0) articles</span>
            </div>

            @if (ViewBag.SebyNews is List<ExternalNewsVMSEBY> sebyNews && sebyNews.Any())
            {
                <div class="row">
                    @foreach (var news in sebyNews)
                    {
                        <div class="col-12 col-md-6 mb-4">
                            <div class="card h-100 shadow-sm border-0">
                                @if (!string.IsNullOrEmpty(news.ImageLink))
                                {
                                    <img src="@news.ImageLink"
                                         class="card-img-top"
                                         alt="@news.Headline"
                                         style="height: 200px; object-fit: cover;"
                                         onerror="this.src='https://placehold.co/600x400?text=Image+Not+Found';" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/600x400?text=No+Image+Available"
                                         class="card-img-top"
                                         alt="No Image Available"
                                         style="height: 200px; object-fit: cover;" />
                                }

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title lh-base">
                                        @(news.Headline?.Length > 80 ? news.Headline.Substring(0, 80) + "..." : news.Headline)
                                    </h5>

                                    @if (!string.IsNullOrEmpty(news.ContentSummary))
                                    {
                                        <p class="card-text text-muted small">
                                            @(news.ContentSummary.Length > 120 ? news.ContentSummary.Substring(0, 120) + "..." : news.ContentSummary)
                                        </p>
                                    }

                                    <div class="mt-auto">
                                        <a href="https://sebynews.azurewebsites.net/Articles/Details/@news.Id"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn btn-outline-primary btn-sm w-100">
                                            <i class="fas fa-external-link-alt me-1"></i> Read Full Article
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="mb-5">
                    <h3 class="text-muted">No News Available</h3>
                    <p class="h6">
                        (Their API Doesn't work) the proof => @ViewBag.ErrorSebyNew
                        <span class="ms-2 text-white hover-bg-secondary small">StatusCode is hard coded</span>
                    </p>                    <p class="text-muted">No news available at the moment. Please check back later.</p>
                    <button class="btn btn-outline-primary" onclick="location.reload()">
                        <i class="fas fa-sync-alt me-1"></i> Refresh
                    </button>
                </div>
            }
        </div>

       

        @if (Model != null && Model.Any())
        {
            
            var groupedNews = Model.GroupBy(n => n.SourceName ?? "Unknown Source");

            foreach (var sourceGroup in groupedNews)
            {
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <h3 class="mb-0 border-bottom pb-2 flex-grow-1">
                            <i class="fas fa-newspaper me-2"></i>@sourceGroup.Key
                        </h3>
                        <span class="badge bg-secondary ms-3">@sourceGroup.Count() articles</span>
                    </div>

                    <div class="row">
                        @foreach (var news in sourceGroup)
                        {
                            <div class="col-12 col-md-6 mb-4">
                                <div class="card h-100 shadow-sm border-0">
                                    @if (!string.IsNullOrEmpty(news.UrlToImage))
                                    {
                                        <div class="position-relative">
                                            <img src="@news.UrlToImage"
                                                 class="card-img-top"
                                                 alt="@news.Title"
                                                 style="height: 200px; object-fit: cover;"
                                                 loading="lazy"
                                                 onerror="this.src='https://placehold.co/600x400?text=Image+Not+Found';">
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-dark bg-opacity-75">@sourceGroup.Key</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="position-relative">
                                            <img src="https://placehold.co/600x400?text=No+Image+Available"
                                                 class="card-img-top"
                                                 alt="No Image Available"
                                                 style="height: 200px; object-fit: cover;">
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-dark bg-opacity-75">@sourceGroup.Key</span>
                                            </div>
                                        </div>
                                    }

                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title lh-base">
                                            @(news.Title?.Length > 80 ? news.Title.Substring(0, 80) + "..." : news.Title)
                                        </h5>

                                        @if (!string.IsNullOrEmpty(news.Description))
                                        {
                                            <p class="card-text text-muted small">
                                                @(news.Description.Length > 120 ? news.Description.Substring(0, 120) + "..." : news.Description)
                                            </p>
                                        }

                                        <div class="card-text mt-auto">
                                            <small class="text-muted d-flex justify-content-between align-items-center">
                                                <span>
                                                    @if (!string.IsNullOrEmpty(news.Author))
                                                    {
                                                        <i class="fas fa-user me-1"></i>
                                                        <span>@news.Author</span>
                                                    }
                                                </span>
                                                <span>
                                                    @if (news.PublishedAt.HasValue)
                                                    {
                                                        <i class="fas fa-clock me-1"></i>
                                                        <span>@news.PublishedAt.Value.ToString("MMM dd, yyyy")</span>
                                                    }
                                                </span>
                                            </small>
                                        </div>

                                        <div class="mt-3">
                                            <a href="@news.Url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-outline-primary btn-sm w-100">
                                                <i class="fas fa-external-link-alt me-1"></i>Read Full Article
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="fas fa-newspaper fa-3x text-muted"></i>
                </div>
                <h3 class="text-muted">No News Available</h3>
                <p class="text-muted">No news available at the moment. Please check back later.</p>
                <button class="btn btn-outline-primary" onclick="location.reload()">
                    <i class="fas fa-refresh me-1"></i>Refresh
                </button>
            </div>
        }
    </div>
}
else
{
    <div class="container my-4">
        <div class="alert alert-light text-center shadow-sm p-4 border-0">
            <div class="mb-3">
                <i class="fas fa-lock fa-3x text-warning"></i>
            </div>
            <h4 class="mb-3"> Access Restricted</h4>
            <p class="mb-4">Please log in and subscribe to view the latest news from our external sources.</p>

            <div class="d-flex gap-2 justify-content-center">
                @if (!User.Identity.IsAuthenticated)
                {
                    <a href="/Identity/Account/Login" class="btn btn-outline-primary">
                        <i class="fas fa-sign-in-alt me-1"></i>Login
                    </a>
                }

                <button type="button"
                        class="btn btn-primary px-4"
                        data-bs-toggle="modal"
                        data-bs-target="#subscribeModal">
                    <i class="fas fa-envelope me-1"></i>Subscribe
                </button>
            </div>
        </div>
    </div>
}


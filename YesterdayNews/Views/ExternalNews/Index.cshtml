@using Microsoft.AspNetCore.Identity
@using YesterdayNews.Models.Db
@using YesterdayNews.Models.ViewModels
@using YesterdayNews.Services.IServices
@model List<ExternalNewsVM>
@inject UserManager<IdentityUser> UserManager
@inject ISubscriptionServices SubscriptionService
@inject IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Our External sources";
    var user = await UserManager.GetUserAsync(User);
    var appUser = user as User;
    var hasActiveSubscription = user != null && SubscriptionService.HasActiveSubscription(user.Id);

}

@if (User.Identity.IsAuthenticated && hasActiveSubscription || User.IsInRole(StaticConsts.Role_Admin) || User.IsInRole(StaticConsts.Role_Editor) || User.IsInRole(StaticConsts.Role_Journalist))
{
   

    <div class="container my-4">

        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold  mb-4">
                <i class="fas fa-handshake me-3"></i>Some News from Our Partners
            </h1>
            <p class="text-muted mb-4">Curated headlines from trusted sources worldwide</p>


            @if (!Environment.IsProduction())
            {
                <div class="badge bg-info mb-3">Development Mode - NewsAPI.org</div>
            }else
            {
                <div class="badge bg-info mb-3">3 Articles is the max according to the free plan 😅</div>

            }

            <!-- Partner Icons Grid -->
            <div class="partner-icons-container">
                <div class="row justify-content-center g-4">
                    <!-- CNN -->
                    <div class="col-auto">
                        <div class="partner-icon" data-bs-toggle="tooltip" title="CNN">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="100" height="100" viewBox="0 0 48 48">

@using YesterdayNews.Models.ViewModels
@model List<ArticleVM>

@{
	ViewData["Title"] = "Yesterday's News";
	bool isAdminViewingCustomer = ViewData["IsAdminViewingCustomer"] != null && (bool)ViewData["IsAdminViewingCustomer"];
}

@if (isAdminViewingCustomer)
{
	<div class="alert alert-info alert-dismissible fade show mt-2 " role="alert">
		<div class="d-flex justify-content-between align-items-center">
			<div>
				<i class="bi bi-info-circle me-2"></i>
				<strong>Admin View:</strong> You are currently viewing the customer experience.
			</div>
			<div>
				<a href="@Url.Action("AdminView", "Home")" class="btn btn-sm btn-primary me-2">
					<i class="bi bi-speedometer2 me-1"></i>Back to Dashboard
				</a>
				@* <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button> *@
			</div>
		</div>
	</div>
}

<div class="container my-4">
	<div class="row justify-content-center">
		<div class="col-12 col-md-7 col-lg-8">
			@await Component.InvokeAsync("JustIn", new {categoryId = ViewData["SelectedCategory"] ?? 0 })
			<div class="mb-2 p-1 pb-0  w-auto d-inline-block text-secondary">
				<h1 class="text-start">Latest News</h1>
			</div>
			@foreach (var article in Model)
			{
				<a asp-controller="Home" asp-action="Details" asp-route-id="@article.Id" class="text-decoration-none text-dark" style="display:block;">
					<article class="mb-4 border p-3 rounded shadow-sm">
						@if (!string.IsNullOrEmpty(article.ImageURL))
						{
							<img src="@article.ImageURL" alt="@article.Headline" class="img-fluid mb-2" style="max-height: 300px; object-fit: cover; width: 100%;" />
						}
						<h2 class="article-underline">@article.Headline</h2>
						@if (!string.IsNullOrEmpty(article.Summary))
						{
							<p>@Html.Raw(article.Summary)...</p>
						}
					</article>
				</a>
			}
			@await Component.InvokeAsync("EarlierNews", new { articlesToSkip = Model.Count, categoryId = ViewData["SelectedCategory"] ?? 0 })
		</div>
		<div class="col-12 col-md-5 col-lg-4">
			@await Component.InvokeAsync("Sidebar", new { categoryId = ViewData["SelectedCategory"] ?? 0 })
		</div>
	</div>
</div>
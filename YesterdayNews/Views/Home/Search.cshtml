@using YesterdayNews.Models.ViewModels
@model List<ArticleVM>

@{
	ViewData["Title"] = "Search Results";
	var query = Context.Request.Query["query"].ToString();
	var archived = Context.Request.Query["archived"] == "true";
}

<div class="container my-4">
	<div class="row justify-content-center">
		<div class="col-12 col-md-7 col-lg-8">
			<div class="m-2 mb-4 p-1 d-none d-lg-flex  bg-primary rounded">
				<form asp-controller="Home" asp-action="Search" method="get" class="d-flex flex-column w-100">
					<div class="d-flex mb-1">
						<input type="text" name="query" value="@query" class="form-control me-2" placeholder="Search news..." />
						<button type="submit" class="btn btn-secondary">
							<i class="bi bi-search"></i>
						</button>
					</div>
					<div class="d-flex align-items-center">
						<div class="form-check ms-2">
							<input class="form-check-input custom-radio" type="radio" name="archived" value="false" id="publishedRadio" @(archived ? "" : "checked") />
							<label class="form-check-label text-white" for="publishedRadio">
								Published
							</label>
						</div>
						<div class="form-check ms-2">
							<input class="form-check-input custom-radio" type="radio" name="archived" value="true" id="archivedRadio" @(archived ? "checked" : "") />
							<label class="form-check-label text-white" for="archivedRadio">
								Archived
							</label>
						</div>
					</div>
				</form>
			</div>


			<h2 class="mb-5">Search Results for "@query" (@(archived ? "Archived" : "Published"))</h2>

			@if (Model == null || !Model.Any())
			{
				<p>No articles found.</p>
			}
			else
			{
				<div class="list-group list-unstyled">
					@foreach (var article in Model)
					{
						<partial name="_ArticleListItemPartial" model="article" />
					}
				</div>
			}
		</div>
		<div class="col-12 col-md-5 col-lg-4">
			@await Component.InvokeAsync("Sidebar")
		</div>
	</div>
</div>
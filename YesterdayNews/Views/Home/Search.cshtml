@using YesterdayNews.Models.ViewModels
@model List<ArticleVM>

@{
	ViewData["Title"] = "Search Results";
	var query = Context.Request.Query["query"].ToString();
	var archived = Context.Request.Query["archived"] == "true";
}

<div class="container my-4">
	<div class="row justify-content-center">
		<div class="col-12 col-md-7 col-lg-8">
			<div class="m-2 mb-4 p-2 d-none d-lg-flex bg-white rounded flex-column gap-2">
				<form asp-controller="Home" asp-action="Search" method="get" class="d-flex flex-column gap-2 w-100">
					<div class="input-group">
						<input type="text" name="query" value="@query" class="form-control" placeholder="Search news..." />
						<button type="submit" class="btn btn-primary">
							<i class="bi bi-search"></i>
						</button>
					</div>
					<div class="btn-group w-100 gap-2" role="group">
						<input type="radio" class="btn-check" name="archived" value="false" id="publishedRadioDesktop" autocomplete="off" @(archived ? "" : "checked")>
						<label class="btn btn-outline-primary" for="publishedRadioDesktop">
							<i class="bi bi-journal-text me-1"></i> Published
						</label>

						<input type="radio" class="btn-check" name="archived" value="true" id="archivedRadioDesktop" autocomplete="off" @(archived ? "checked" : "")>
						<label class="btn btn-secondary" for="archivedRadioDesktop">
							<i class="bi bi-archive me-1"></i> Archived
						</label>
					</div>
				</form>
			</div>


			<h2 class="mb-5">Search Results for "@query" (@(archived ? "Archived" : "Published"))</h2>

			@if (Model == null || !Model.Any())
			{
				<p>No articles found.</p>
			}
			else
			{
				<div class="list-group list-unstyled">
					@foreach (var article in Model)
					{
						<partial name="_ArticleListItemPartial" model="article" />
					}
				</div>
			}
		</div>
		<div class="col-12 col-md-5 col-lg-4">
			@await Component.InvokeAsync("Sidebar")
		</div>
	</div>
</div>
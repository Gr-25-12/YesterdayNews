
@model FinanceServices.Models.MarketDto
@{
    ViewData["Title"] = "Markets";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-8">

            <!-- Market Status Header -->
            <div class="card mb-4 bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h4 class="mb-0 text-primary">
                                <i class="fas fa-chart-line me-2"></i>Market Overview
                            </h4>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="badge bg-@(Model.UsMarketStatus == "Open" ? "success" : "danger") fs-6">
                                <i class="fas fa-circle me-1 small"></i>US Markets: @Model.UsMarketStatus
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NASDAQ -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="devicon-nasdaq-plain colored me-2 fs-4"></i>
                        NASDAQ
                        <span class="badge ms-2 bg-@(Model.UsMarketStatus == "Open" ? "success" : "danger")">
                            @Model.UsMarketStatus
                        </span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Stock</th>
                                    <th>Price (USD)</th>
                                    <th>Change</th>
                                    <th class=" pe-4">% Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.NasdaqStocks.Count <= 0 && Model.UsMarketStatus.Contains("Closed") == false)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-danger py-3">
                                            <i class="fas fa-exclamation-triangle me-2"></i>No data available
                                        </td>
                                    </tr>
                                }
                                @foreach (var stock in Model.NasdaqStocks)
                                {
                                    if (stock != null)
                                    {
                                        <tr data-exchange="NASDAQ" data-symbol="@stock.Symbol">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <i class="@(StaticConsts.GetIconClass(stock.Symbol)) me-2"></i>
                                                    <span class="@(stock.DisplayName == "(Missing data)" ? "text-danger" : "fw-medium")">
                                                        @stock.DisplayName
                                                    </span>
                                                </div>
                                            </td>
                                            @if (!Model.UsMarketStatus.Contains("Closed"))
                                            {
                                                <td class="price fw-bold">
                                                    @(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : "-")
                                                </td>
                                                <td class="change">-</td>
                                                <td class="percentage  pe-4">-</td>
                                            }
                                            else
                                            {
                                                <td class="fw-bold">
                                                    @(stock.ClosingPrice != 0 ? stock.ClosingPrice.ToString("0.##") : "-")
                                                </td>
                                                <td>-</td>
                                                <td class=" pe-4">-</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>Price changes calculated from yesterday's closing prices
                    </small>
                </div>
            </div>

            <!-- NYSE -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-building-columns text-primary me-2 fs-4"></i>
                        NYSE
                        <span class="badge ms-2 bg-@(Model.UsMarketStatus == "Open" ? "success" : "danger")">
                            @Model.UsMarketStatus
                        </span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Stock</th>
                                    <th>Price (USD)</th>
                                    <th>Change</th>
                                    <th class=" pe-4">% Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.NyseStocks.Count <= 0 && !Model.UsMarketStatus.Contains("Closed"))
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-danger py-3">
                                            <i class="fas fa-exclamation-triangle me-2"></i>No data available
                                        </td>
                                    </tr>
                                }
                                @foreach (var stock in Model.NyseStocks)
                                {
                                    if (stock != null)
                                    {
                                        <tr data-exchange="NYSE" data-symbol="@stock.Symbol">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <i class="@(StaticConsts.GetIconClass(stock.Symbol)) me-2"></i>
                                                    <span class="@(stock.DisplayName == "(Missing data)" ? "text-danger" : "fw-medium")">
                                                        @stock.DisplayName
                                                    </span>
                                                </div>
                                            </td>
                                            @if (!Model.UsMarketStatus.Contains("Closed"))
                                            {
                                                <td class="price fw-bold">
                                                    @(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : "-")
                                                </td>
                                                <td class="change">-</td>
                                                <td class="percentage pe-4">-</td>
                                            }
                                            else
                                            {
                                                <td class="fw-bold">
                                                    @(stock.ClosingPrice != 0 ? stock.ClosingPrice.ToString("0.##") : "-")
                                                </td>
                                                <td>-</td>
                                                <td class=" pe-4">-</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>Price changes calculated from yesterday's closing prices
                    </small>
                </div>
            </div>

            <!-- Crypto -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fab fa-bitcoin text-warning me-2 fs-4"></i>
                        Cryptocurrency
                        <span class="badge ms-2 bg-success">
                            <i class="fas fa-circle me-1 small"></i>Open
                        </span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Crypto</th>
                                    <th>Price (USD)</th>
                                    <th>Change</th>
                                    <th class=" pe-4">% Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CryptoPrices.Count <= 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-danger py-3">
                                            <i class="fas fa-exclamation-triangle me-2"></i>No data available
                                        </td>
                                    </tr>
                                }
                                @foreach (var crypto in Model.CryptoPrices)
                                {
                                    if (crypto != null)
                                    {
                                        <tr data-exchange="CRYPTO" data-symbol="@crypto.Symbol">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <i class="@(StaticConsts.GetCryptoClass(crypto.Symbol)) me-2"></i>
                                                    <span class="@(crypto.Description == "(Missing data)" ? "text-danger" : "fw-medium")">
                                                        @crypto.Description
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="price fw-bold">
                                                @(crypto.CurrentPrice != 0 ? crypto.CurrentPrice.ToString("0.##") : "-")
                                            </td>
                                            <td class="change">-</td>
                                            <td class="percentage  pe-4">-</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>Price changes calculated from 24 hours ago
                    </small>
                </div>
            </div>

            <!-- Forex -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-money-bill-wave text-success me-2 fs-4"></i>
                        Forex Currencies
                        <span class="badge ms-2 bg-success">
                            <i class="fas fa-circle me-1 small"></i>Open
                        </span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Currency</th>
                                    <th>Price (USD)</th>
                                    <th>Change</th>
                                    <th class=" pe-4">% Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Currencies.Count <= 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-danger py-3">
                                            <i class="fas fa-exclamation-triangle me-2"></i>No data available
                                        </td>
                                    </tr>
                                }
                                @foreach (var forex in Model.Currencies)
                                {
                                    if (forex != null)
                                    {
                                        <tr data-exchange="FOREX" data-symbol="@forex.Symbol">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <i class="@(StaticConsts.GetForexClass(forex.DisplaySymbol, forex.Description)) me-2"></i>


                                                    <span class="@(forex.Description == "(Missing data)" ? "text-danger" : "fw-medium")">
                                                        @forex.Description
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="price fw-bold">
                                                @(forex.CurrentPrice != 0 ? forex.CurrentPrice.ToString("0.##") : "-")
                                            </td>
                                            <td class="change">-</td>
                                            <td class="percentage  pe-4">-</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>Price changes calculated from 24 hours ago
                    </small>
                </div>
            </div>

            <!-- Commodities -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-oil-well text-danger me-2 fs-4"></i>
                        Oil & Metals
                        <span class="badge ms-2 bg-success">
                            <i class="fas fa-circle me-1 small"></i>Open
                        </span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Commodity</th>
                                    <th>Price (USD)</th>
                                    <th>Change</th>
                                    <th class="pe-4">% Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Commodities.Count <= 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-danger py-3">
                                            <i class="fas fa-exclamation-triangle me-2"></i>No data available
                                        </td>
                                    </tr>
                                }
                                @foreach (var comm in Model.Commodities)
                                {
                                    if (comm != null)
                                    {
                                        <tr data-exchange="FOREX" data-symbol="@comm.Symbol">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <i class="@(StaticConsts.GetCommodityClass(comm.Description)) me-2"></i>

                                                    <span class="@(comm.Description == "(Missing data)" ? "text-danger" : "fw-medium")">
                                                        @comm.Description
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="price fw-bold">
                                                @(comm.CurrentPrice != 0 ? comm.CurrentPrice.ToString("0.##") : "-")
                                            </td>
                                            <td class="change">-</td>
                                            <td class="percentage  pe-4">-</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>Price changes calculated from 24 hours ago
                    </small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-5 col-lg-4">
            @await Component.InvokeAsync("Sidebar", new { categoryId = ViewData["SelectedCategory"] ?? 0 })
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>
<script src="/js/Markets.js"></script>


@model FinanceServices.Models.MarketDto;
@{
	ViewData["Title"] = "Markets";
}

<div class="container my-4">
	<div class="row justify-content-center">
		<div class="col-12 col-md-7 col-lg-8">
            <div class="card p-3 mb-3">
				<h3>Nasdaq</h3>
                <div class="table-responsive">
                    <table id="marketTable" class="table dt-responsive nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Price</th>
                                <th>Diff</th>
                                <th>In %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in Model.NasdaqStockInfo)
                            {
                                var symbol = kvp.Key;
                                var stock = kvp.Value;
                                var quote = Model.NasdaqStockPrices.ContainsKey(symbol) ? Model.NasdaqStockPrices[symbol] : null;
                                if (quote == null) continue;
                                <tr data-symbol="@symbol">
                                    <td class="fw-bold">@stock.Description</td>
                                    <td class="price">@quote.CurrentPrice.ToString("0.##")</td>
                                    <td class="change">@(quote.Change >= 0 ? "+" : "")@quote.Change.ToString("0.######")</td>
                                    <td class="percentage @(quote.PercentageChange >= 0 ? "up" : "down")">
                                        (@quote.PercentageChange.ToString("0.##")%)
                                    </td>
                                </tr>
                            }
                        </tbody>
                        </table>
                        </div>
                <div>
                    <small>
                        (Price changes are calculated from yesterdays closing prices)
                    </small>
                </div>
			</div>
            <div class="card p-3 mb-3">
				<h3>New York Stock Exchange</h3>
                <div class="table-responsive">
                    <table id="marketTable" class="table dt-responsive nowrap" style="width:100%">
                        @* NYSE *@
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Price</th>
                                <th>Diff</th>
                                <th>In %</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var kvp in Model.NyseStockInfo)
                            {
                                var symbol = kvp.Key;
                                var stock = kvp.Value;
                                var quote = Model.NyseStockPrices.ContainsKey(symbol) ? Model.NyseStockPrices[symbol] : null;
                                if (quote == null) continue;
                                <tr data-symbol="@symbol">
                                    <td class="fw-bold">@stock.Description</td>
                                    <td class="price">@quote.CurrentPrice.ToString("0.##")</td>
                                    <td class="change">@(quote.Change >= 0 ? "+" : "")@quote.Change.ToString("0.######")</td>
                                    <td class="percentage @(quote.PercentageChange >= 0 ? "up" : "down")">
                                        (@quote.PercentageChange.ToString("0.##")%)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                    <small>
                        (Price changes are calculated from yesterdays closing prices)
                    </small>
                </div>
			</div>
            <div class="card p-3 mb-3">
                <div class="d-flex align-items-center mb-2">
                    <h3 class="me-2">Crypto</h3>
                    <p class="fs-5">(from Binance)</p>
                </div>
                <div class="table-responsive">
                    <table id="marketTable" class="table dt-responsive nowrap" style="width:100%">
                        @* Binance / Crypto *@
                        <thead>
                            <tr>
                                <th>Trading Pairs</th>
                                <th>Price</th>
                                <th>Diff</th>
                                <th>In %</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var kvp in Model.CryptoPrices)
                            {
                                var symbol = kvp.Key;
                                var crypto = kvp.Value;
                                var quote = Model.CryptoPrices.ContainsKey(symbol) ? Model.CryptoPrices[symbol] : null;
                                if (quote == null) continue;
                                <tr data-symbol="@symbol">
                                    <td class="fw-bold">@crypto.DisplaySymbol</td>
                                    <td class="price">@quote.CurrentPrice.ToString("0.##")</td>
                                    <td class="change">@(quote.Change >= 0 ? "+" : "")@quote.Change.ToString("0.######")</td>
                                    <td class="percentage @(quote.PercentageChange >= 0 ? "up" : "down")">
                                        (@quote.PercentageChange.ToString("0.##")%)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                    <small>
                        (Price changes are calculated from prices 24 hours ago)
                    </small>
                </div>
			</div>
		</div>
        <div class="col-12 col-md-5 col-lg-4">
            @await Component.InvokeAsync("Sidebar", new { categoryId = ViewData["SelectedCategory"] ?? 0 })
        </div>
	</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>
<script src="/js/Markets.js"></script>
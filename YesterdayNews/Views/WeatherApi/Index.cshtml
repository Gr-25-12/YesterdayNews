@model List<YesterdayNews.Models.ViewModels.ForecastVM>

@{
    ViewData["Title"] = "Weather Forecast";
}

<h2>Weather Forecast</h2>

<form method="get" asp-controller="WeatherApi" asp-action="Index">
    <input type="text" name="city" placeholder="Enter city name" />
    <button type="submit">Search</button>
</form>

@if (!Model.Any())
{
    <p>@ViewBag.Message</p>
}
else
{
    @await Html.PartialAsync("_ForecastPartial", Model)
}

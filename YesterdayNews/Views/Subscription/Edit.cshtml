					<input type="submit" value="Save Changes" class="btn btn-primary" />
				</div>
			}			
		</form>
		<div class="text-start">
			<a asp-action="Index">Back to List</a>
		</div>
	</div>
</div>

@section Scripts {

	<script src="~/js/subscription.js"></script>
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}

 *@

					@using System.Globalization
@using YesterdayNews.Models.Db
@model YesterdayNews.Models.Db.Subscription

@{
    ViewData["Title"] = "Edit Subscription";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="mt-3 d-flex justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary border-1 border-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 text-center">Edit Subscription</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <!-- Dates -->
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="Created" class="form-label">Subscription Start Date</label>
                                <input asp-for="Created" type="date" id="createdDate" class="form-control" readonly disabled />
                                <input type="hidden" asp-for="Created" id="Created" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subscription End Date</label>
                                @if (Model.IsDeleted)
                                {
                                    <input asp-for="Expires" type="date" id="Expires" class="form-control" readonly disabled />
                                }
                                else
                                {
                                    <input asp-for="Expires" type="date" id="Expires" class="form-control" />
                                }
                                <span asp-validation-for="Expires" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- User Info -->
                        <div class="form-group mb-4">
                            <label class="form-label">User</label>
                            <div class="border p-3 bg-light rounded">
                                <div class="d-flex flex-wrap gap-3">
                                    <div><strong>First Name:</strong> @Model.User?.FirstName</div>
                                    <div><strong>Last Name:</strong> @Model.User?.LastName</div>
                                    <div><strong>Email:</strong> @Model.User?.Email</div>
                                </div>
                            </div>
                            <input type="hidden" asp-for="UserId" name="UserId" />
                        </div>

                        <!-- Subscription Type -->
                        @if (!Model.IsDeleted)
                        {
                            <div class="form-group mb-4">
                                <label for="SubscriptionTypeId" class="form-label">Subscription Type</label>
                                <select asp-for="SubscriptionTypeId" class="form-control" id="SubscriptionTypeId">
                                    <option value="">-- Choose SubscriptionType --</option>
                                    @foreach (var type in (List<SubscriptionType>)ViewBag.SubscriptionTypes)
                                    {
                                        <option value="@type.Id"
                                                data-plan="@type.TypeName"
                                                data-accesslevel="@type.Description"
                                                data-price="@type.Price.ToString("C", new CultureInfo("sv-SE"))"
                                                selected="@(type.Id == Model.SubscriptionTypeId)">
                                            @type.TypeName
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="SubscriptionTypeId" class="text-danger small"></span>
                            </div>
                        }

                        <!-- Subscription Plan Info -->
                        <div id="subscriptionPriceRow" class="mb-4" style="display:block;">
                            <div class="border p-3 bg-light rounded">
                                <div class="d-flex flex-wrap gap-3">
                                    <div><strong>Plan:</strong> <span id="planText">@Model.SubscriptionType.TypeName</span></div>
                                    <div><strong>Access Level:</strong> <span class="text-wrap text-break max-w-100" id="accessLevelText">@Html.Raw(Model.SubscriptionType.Description)</span></div>
                                    <div><strong>Price:</strong> <span id="priceText">@Model.SubscriptionType.Price.ToString("C", new CultureInfo("sv-SE"))</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Save Button -->
                        @if (!Model.IsDeleted)
                        {
                            <div class="form-group text-end">
                                <input type="submit" value="Save Changes" class="btn btn-primary px-4" />
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/subscription.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

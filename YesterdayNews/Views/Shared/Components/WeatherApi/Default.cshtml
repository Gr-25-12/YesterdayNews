@model List<YesterdayNews.Models.ViewModels.ForecastVM>

@if (Model?.Any() == true)
{
    var f = Model.First(); // Only take the closest/current forecast

    <div class="forecast-summary text-center mb-3">
        @{
            string cityName = f.City;
            if (cityName.EndsWith(" Municipality"))
            {
                cityName = cityName.Replace(" Municipality", "");
            }
        }
        <h4>@cityName</h4>
    </div>

    <div class="forecast-list d-flex justify-content-center gap-3 flex-wrap">
        <div class="forecast-day card p-3 text-center" style="min-width: 120px;">
            <div class="small text-muted">@f.Date.ToString("ddd, MMM dd")</div>
            @if (!string.IsNullOrEmpty(f.IconUrl))
            {
                <img src="@f.IconUrl" alt="@f.Summary" class="mx-auto d-block" style="width: 50px; height: 50px;" />
            }
            <div class="fw-bold">@f.TemperatureC°C</div>
            <div class="small">@f.Summary</div>
        </div>
    </div>
}
else
{
    <div class="text-center text-muted">
        <div>Loading weather data...</div>
    </div>
}

@model YesterdayNews.Models.ViewModels.ForecastVM

<a asp-controller="Weather" asp-action="Index" class="flex-grow-1 text-decoration-none d-block">
    <article class="mb-4  bg-white" id="weather-widget">
        @if (Model != null && !string.IsNullOrEmpty(Model.City))
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-primary fw-bold mb-0">Weather</h5>
                <div class="small text-muted">
                    <time datetime="@Model.Date.ToString("yyyy-MM-dd")">@Model.Date.ToString("ddd, MMM dd")</time>
                </div>
            </div>

            <hr class="my-3" />
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="text-dark fw-bold mb-3">@Model.DisplayLocation</h4>
                    <img src="@Model.IconUrl" alt="@(Model.Summary ?? "Weather Icon")" class="img-fluid" style="width: 110px; height: 110px;" />
                </div>

                <div class="text-end d-flex flex-column align-items-end justify-content-center">
                    <div class="display-6 fw-bold text-primary mb-2">@Model.TemperatureC°C</div>
                    <div class="h5 text-muted fw-normal text-capitalize mb-0">@Model.Summary</div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <div class="mb-2">
                    <i class="fas fa-sun fa-2x opacity-50"></i>
                </div>
                Loading weather data...
            </div>
        }
    </article>
</a>


@model YesterdayNews.Models.ViewModels.ForecastVM


<a asp-controller="Weather" asp-action="Index" class="flex-grow-1 text-decoration-none d-block">
    <article class="mb-4 border p-3 pb-0 rounded shadow-sm" id="weather-widget">
        @if (Model != null && !string.IsNullOrEmpty(Model.City) )
        {
            <div class="d-flex justify-content-between">
                <h5 class="text-secondary">Weather</h5>
                <div class="small text-muted">
                    <time datetime="@Model.Date.ToString("yyyy-MM-dd")">@Model.Date.ToString("ddd, MMM dd")</time>
                </div>
            </div>

            <hr class="my-2" />
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 style="font-size: 1.15rem;">@Model.DisplayLocation</h4>
                    <img src="@Model.IconUrl" alt="@(Model.Summary ?? "Weather Icon")" style="width: 100px; height: 100px; margin: 0;" />
                </div>

                <div class="text-end d-flex flex-column align-items-end justify-content-center">
                    <div class="fw-bold">@Model.TemperatureC°C</div>
                    <h3 class="small text-muted">@Model.Summary</h3>
                </div>
            </div>
        }
        else
        {
            <div class="text-center text-muted">Loading weather data...</div>
        }
    </article>
</a>

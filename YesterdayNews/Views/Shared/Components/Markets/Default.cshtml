@model FinanceServices.Models.MarketDto
@* Markets View Component *@
<article class="mb-4 border p-3 pb-0 rounded shadow-sm">
    <a asp-controller="Home" asp-action="Markets" class="flex-grow-1 text-decoration-none d-block">
        <h5 class="text-secondary">Markets (in USD)</h5>

        <hr class="my-2" />
        <div class="table-responsive">
            <table id="marketTable" class="table dt-responsive nowrap" style="width:100%">

                @* Stocks - NASDAQ & NYSE combined *@
                @foreach (var (exchangeName, stocks) in new[] { ("NASDAQ", Model.NasdaqStocks), ("NYSE", Model.NyseStocks) })
                {
                    <thead class="border-bottom">
                        <tr>
                            <th>
                                @exchangeName -         <i class="fas fa-circle @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger") small"></i>
                            </th>
                            <th>Price</th>
                            <th></th> @* Arrow column *@
                        </tr>
                    </thead>
                    <tbody>
                        @if (stocks.Count <= 0 && !Model.UsMarketStatus.Contains("Closed"))
                        {
                            <tr>
                                <td class="text-danger">(Error, No data loaded)</td>
                                <td>-</td>
                                <td></td>
                            </tr>
                        }
                        @foreach (var stock in stocks)
                        {
                            if (stock == null) continue;
                            var diff = stock.CurrentPrice - (stock.ClosingPrice != 0 ? stock.ClosingPrice : stock.CurrentPrice);
                            var arrowClass = diff > 0 ? "text-success fas fa-arrow-up" : diff < 0 ? "text-danger fas fa-arrow-down" : "text-muted fas fa-minus";
                            <tr data-exchange="@exchangeName" data-symbol="@stock.Symbol">
                                <td class="description @(stock.DisplayName == "(Missing data)" ? "text-danger" : "")">
                                    <i class="@(StaticConsts.GetIconClass(stock.Symbol)) me-2"></i> @stock.DisplayName
                                </td>
                                <td class="price">@stock.CurrentPrice.ToString("0.##")</td>
                                <td class="text-center"><i class="@arrowClass"></i></td>
                            </tr>
                        }
                    </tbody>
                }

                @* Crypto *@
                <thead class="border-bottom">
                    <tr>
                        <th>CRYPTO - <span class="status-bar text-success">(Open)</span></th>
                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var crypto in Model.CryptoPrices)
                    {
                        if (crypto == null) continue;
                        var diff = crypto.CurrentPrice - crypto.Price24HoursAgo;
                        var arrowClass = diff > 0 ? "text-success fas fa-arrow-up" : diff < 0 ? "text-danger fas fa-arrow-down" : "text-muted fas fa-minus";
                        <tr data-exchange="CRYPTO" data-symbol="@crypto.Symbol">
                            <td>
                                <i class="@(StaticConsts.GetCryptoClass(crypto.Symbol)) me-2"></i> @crypto.Description
                            </td>
                            <td class="price">@crypto.CurrentPrice.ToString("0.##")</td>
                            <td class="text-center"><i class="@arrowClass"></i></td>
                        </tr>
                    }
                </tbody>

                @* Forex *@
                <thead class="border-bottom">
                    <tr>
                        <th>Forex -         <i class="fas fa-circle @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger") small"></i>

                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forex in Model.Currencies)
                    {
                        if (forex == null) continue;
                        var diff = forex.CurrentPrice - forex.Price24HoursAgo;
                        var arrowClass = diff > 0 ? "text-success fas fa-arrow-up" : diff < 0 ? "text-danger fas fa-arrow-down" : "text-muted fas fa-minus";
                        <tr data-exchange="FOREX" data-symbol="@forex.Symbol">
                            <td>
                                <i class="@(StaticConsts.GetForexClass(forex.DisplaySymbol, forex.Description)) me-2"></i>@forex.Description
                            </td>
                            <td class="price">@forex.CurrentPrice.ToString("0.##")</td>
                            <td class="text-center"><i class="@arrowClass"></i></td>
                        </tr>
                    }
                </tbody>

                @* Commodities *@
                <thead class="border-bottom">
                    <tr>
                        <th>Oil & Metals -         <i class="fas fa-circle @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger") small"></i>

                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comm in Model.Commodities)
                    {
                        if (comm == null) continue;
                        var diff = comm.CurrentPrice - comm.Price24HoursAgo;
                        var arrowClass = diff > 0 ? "text-success fas fa-arrow-up" : diff < 0 ? "text-danger fas fa-arrow-down" : "text-muted fas fa-minus";
                        <tr data-exchange="COMMODITIES" data-symbol="@comm.Symbol">
                            <td>
                                <i class="@(StaticConsts.GetCommodityClass(comm.Description)) me-2"></i> @comm.Description
                            </td>
                            <td class="price">@comm.CurrentPrice.ToString("0.##")</td>
                            <td class="text-center"><i class="@arrowClass"></i></td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </a>
</article>

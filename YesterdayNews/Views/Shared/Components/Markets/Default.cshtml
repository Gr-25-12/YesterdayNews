@model FinanceServices.Models.MarketDto;
@* Markets View Component *@
<article class="mb-4 border p-3 pb-0 rounded shadow-sm">
	<a asp-controller="Home" asp-action="Markets" class="flex-grow-1 text-decoration-none d-block">
		<h5 class="text-secondary">Markets (in USD)</h5>

		<hr class="my-2" />
		<div class="table-responsive">
			<table id="marketTable" class="table dt-responsive nowrap" style="width:100%">
				@* NASDAQ *@
				<thead class="border-bottom">
					<tr>
						<th>
							NASDAQ -
							<span class="status-bar @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger")">
								(@Model.UsMarketStatus)
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.NasdaqStocks.Count <= 0 && Model.UsMarketStatus != "Closed")
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var stock in Model.NasdaqStocks)
					{
						if (stock == null) continue;
						<tr data-exchange="NASDAQ" data-symbol="@stock.Symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(stock?.DisplayName) ? "(No data)" : stock.DisplayName)
							</td>
							@if (Model.UsMarketStatus != "Closed")
							{
								<td class="price">
									@(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : " - ")
								</td>
								<td class="change"> - </td>
								<td class="percentage"> - </td>
							}
							else
							{
								<td>
									@(stock.ClosingPrice != 0 ? stock.ClosingPrice.ToString("0.##") : " - ")
								</td>
								<td> - </td>
								<td> - </td>
							}
						</tr>
					}

				</tbody>
				@* NYSE *@
				<thead class="border-bottom">
					<tr>
						<th>
							NYSE -
							<span class="status-bar @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger")">
								(@Model.UsMarketStatus)
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.NyseStocks.Count <= 0 && Model.UsMarketStatus != "Closed")
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var stock in Model.NyseStocks)
					{
						if (stock == null) continue;
						<tr data-exchange="NYSE" data-symbol="@stock.Symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(stock?.DisplayName) ? "(No data)" : stock.DisplayName)
							</td>
							@if (Model.UsMarketStatus != "Closed")
							{
								<td class="price">
									@(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : " - ")
								</td>
								<td class="change"> - </td>
								<td class="percentage"> - </td>
							}
							else
							{
								<td>
									@(stock.ClosingPrice != 0 ? stock.ClosingPrice.ToString("0.##") : " - ")
								</td>
								<td> - </td>
								<td> - </td>
							}
						</tr>
					}
				</tbody>
				@* Binance / Crypto *@
				<thead class="border-bottom">
					<tr>
						<th>
							CRYPTO -
							<span class="status-bar text-success" )">
								( Open )
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.CryptoPrices.Count <= 0)
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var crypto in Model.CryptoPrices)
					{
						if (crypto == null) continue;
						<tr data-exchange="CRYPTO" data-symbol="@crypto.Symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(crypto?.DisplaySymbol) ? "(No data)" : crypto.DisplaySymbol)
							</td>
							<td class="price">
								@(crypto.CurrentPrice != 0 ? crypto.CurrentPrice.ToString("0.##") : " - ")
							</td>
							<td class="change"> - </td>
							<td class="percentage"> - </td>
						</tr>
					}
				</tbody>
				@* Forex *@
				<thead class="border-bottom">
					<tr>
						<th>
							Forex -
							<span class="status-bar text-success" )">
								( Open )
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Currencies.Count <= 0)
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var forex in Model.Currencies)
					{
						if (forex == null) continue;
						<tr data-exchange="FOREX" data-symbol="@forex.Symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(forex?.Description) ? "(No data)" : forex.Description)
							</td>
							<td class="price">
								@(forex.CurrentPrice != 0 ? forex.CurrentPrice.ToString("0.##") : " - ")
							</td>
							<td class="change"> - </td>
							<td class="percentage"> - </td>
						</tr>
					}
				</tbody>
				@* Commodities *@
				<thead class="border-bottom">
					<tr>
						<th>
							Oil & Metals -
							<span class="status-bar text-success" )">
								( Open )
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Commodities.Count <= 0)
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var forex in Model.Commodities)
					{
						if (forex == null) continue;
						<tr data-exchange="COMMODITIES" data-symbol="@forex.Symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(forex?.Description) ? "(No data)" : forex.Description)
							</td>
							<td class="price">
								@(forex.CurrentPrice != 0 ? forex.CurrentPrice.ToString("0.##") : " - ")
							</td>
							<td class="change"> - </td>
							<td class="percentage"> - </td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</a>
</article>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>
<script src="/js/Markets.js"></script>
@model FinanceServices.Models.MarketDto;
@* Markets View Component *@
<article class="mb-4 border p-3 pb-0 rounded shadow-sm">
	<a asp-controller="Home" asp-action="Markets" class="flex-grow-1 text-decoration-none d-block">
		<h5 class="text-secondary">Markets</h5>

		<hr class="my-2" />
		<div class="table-responsive">
			<table id="marketTable" class="table dt-responsive nowrap" style="width:100%">
				@* NASDAQ *@
				<thead class="border-bottom">
					<tr>
						<th>
							NASDAQ -
							<span class="status-bar @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger")">
								(@Model.UsMarketStatus)
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.NasdaqStocks.Count <= 0)
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var kvp in Model.NasdaqStocks)
					{
						var symbol = kvp.Key;
						var stock = kvp.Value;
						if (stock == null) continue;
						<tr data-exchange="NASDAQ" data-symbol="@symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(stock?.DisplayName) ? "(No data)" : stock.DisplayName)
							</td>
							@if (Model.UsMarketStatus != "Closed")
							{
								<td class="price">
									@(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : " - ")
								</td>
								<td class="change"> - </td>
								<td class="percentage"> - </td>
							}
							else
							{
								<td>
									@(stock.ClosingPrice != 0 ? stock.ClosingPrice.ToString("0.##") : " - ")
								</td>
								<td> - </td>
								<td> - </td>
							}
						</tr>
					}
				</tbody>
				@* NYSE *@
				<thead class="border-bottom">
					<tr>
						<th>
							NYSE -
							<span class="status-bar @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger")">
								(@Model.UsMarketStatus)
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.NyseStocks.Count <= 0)
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var kvp in Model.NyseStocks)
					{
						var symbol = kvp.Key;
						var stock = kvp.Value;
						if (stock == null) continue;
						<tr data-exchange="NYSE" data-symbol="@symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(stock?.DisplayName) ? "(No data)" : stock.DisplayName)
							</td>
							@if (Model.UsMarketStatus != "Closed")
							{
								<td class="price">
									@(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : " - ")
								</td>
								<td class="change"> - </td>
								<td class="percentage"> - </td>
							}
							else
							{
								<td>
									@(stock.ClosingPrice != 0 ? stock.ClosingPrice.ToString("0.##") : " - ")
								</td>
								<td> - </td>
								<td> - </td>
							}
						</tr>
					}
				</tbody>
				@* Binance / Crypto *@
				<thead class="border-bottom">
					<tr>
						<th>
							CRYPTO -
							<span class="status-bar @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger")">
								(@Model.UsMarketStatus)
							</span>
						</th>
						<th>Price</th>
						<th>Diff</th>
						<th>In %</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.CryptoPrices.Count <= 0)
					{
						<tr>
							<td class="text-danger"> (Error, No data loaded)</td>
							<td> - </td>
							<td> - </td>
							<td> - </td>
						</tr>
					}
					@foreach (var kvp in Model.CryptoPrices)
					{
						var symbol = kvp.Key;
						var crypto = kvp.Value;
						if (crypto == null) continue;
						<tr data-exchange="CRYPTO" data-symbol="@symbol">
							<td class="description">
								@(string.IsNullOrWhiteSpace(crypto?.DisplaySymbol) ? "(No data)" : crypto.DisplaySymbol)
							</td>
							<td class="price">
								@(crypto.CurrentPrice != 0 ? crypto.CurrentPrice.ToString("0.##") : " - ")
							</td>
							<td class="change"> - </td>
							<td class="percentage"> - </td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</a>
</article>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>
<script src="/js/Markets.js"></script>
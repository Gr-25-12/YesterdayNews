@model FinanceServices.Models.MarketDto
@* Markets View Component *@

<article class="mb-4 border p-3 pb-0 rounded shadow-sm">
    <a asp-controller="Home" asp-action="Markets" class="flex-grow-1 text-decoration-none d-block">
        <h5 class="text-secondary">Markets (in USD)</h5>
        <hr class="my-2" />
        <div class="table-responsive">
            <table id="marketTable" class="table dt-responsive nowrap" style="width:100%">

                @* NASDAQ *@
                <thead class="border-bottom">
                    <tr>
                        <th>Logo</th>
                        <th>
                            NASDAQ -
                            <span class="status-bar @(Model.UsMarketStatus == "Open" ? "text-success" : "text-danger")">
                                (@Model.UsMarketStatus)
                            </span>
                        </th>
                        <th>Price</th>
                        <th>Diff</th>
                        <th>In %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stock in Model.NasdaqStocks)
                    {
                        if (stock == null) continue;
                        <tr data-exchange="NASDAQ" data-symbol="@stock.Symbol">
                            <td>
                                @* Try company logo from Clearbit if WebsiteDomain is available *@
                                @if (!string.IsNullOrEmpty(stock.WebsiteDomain))
                                {
                                    <img src="https://logo.clearbit.com/@stock.WebsiteDomain"
                                         alt="@stock.DisplayName"
                                         width="24" height="24"
                                         style="object-fit:contain;" />
                                }
                                else
                                {
                                    @* Fallback: DevIcon by exchange type *@
                                    <i class="devicon-google-plain colored" style="font-size:24px;"></i>
                                }
                            </td>
                            <td class="description @(stock.DisplayName == "(Missing data)" ? "text-danger" : "")">
                                <a href="@stock.WebsiteDomain" target="_blank" class="text-decoration-none text-dark">
                                    @stock.DisplayName
                                </a>
                            </td>
                            <td class="price">
                                @(stock.CurrentPrice != 0 ? stock.CurrentPrice.ToString("0.##") : " - ")
                            </td>
                            <td>
                                @(stock.Change != 0 ? stock.Change.ToString("0.##") : " - ")
                            </td>
                            <td>
                                @(stock.PercentageChange != 0 ? stock.PercentageChange.ToString("0.##") + "%" : " - ")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </a>
</article>

@* Import DevIcon CSS *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

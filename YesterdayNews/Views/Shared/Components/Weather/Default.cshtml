@model YesterdayNews.Models.Api.Weather

@if (Model == null)
{
    <p>No weather data available.</p>
}
else
{
    <div class="weather-forecast">
        <h3>Current Weather for @Model.City</h3>
        <p><strong>Date/Time:</strong> @Model.Date.ToString("g")</p>
        <p><strong>Summary:</strong> @Model.Summary</p>
        <p><strong>Temperature:</strong> @Model.TemperatureC &deg;C / @Model.TemperatureF &deg;F</p>
        <p><strong>Humidity:</strong> @Model.Humidity %</p>
        <p><strong>Wind Speed:</strong> @Model.WindSpeed km/h</p>
        @if (Model.Icon != null)
        {
            <img src="@Model.Icon.Url" alt="@Model.Icon.Code" />
        }
    </div>
}

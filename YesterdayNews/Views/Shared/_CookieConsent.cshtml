<div id="cookieConsent" class="cookie-banner hidden">
    <button id="closeCookieBanner" class="absolute top-2 right-2 text-gray-600 hover:text-black">
        ✕
    </button>
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between">
        <div>
            <p class="mb-2">
                At <strong class="text-blue-800">YesterdayNews</strong>, we use cookies to make the website work as well as possible for you.
                We also use cookies for web analytics to make the website better.
            </p>
            <a href="/Home/Privacy" class="text-blue-600 hover:text-blue-800 underline text-sm">
                Learn more about how YesterdayNews uses cookies
            </a>
        </div>
        <div class="flex gap-2 mt-3 md:mt-0">
            <button id="acceptAllCookies"
                    class="border border-blue-700 text-blue-700 hover:bg-blue-700 hover:text-white px-4 py-2 rounded-lg">
                Yes, I agree to all cookies
            </button>
            <button id="acceptNecessaryCookies"
                    class="border border-blue-700 text-blue-700 hover:bg-blue-700 hover:text-white px-4 py-2 rounded-lg">
                No, I only agree to necessary cookies
            </button>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const banner = document.getElementById("cookieConsent");
        const closeBtn = document.getElementById("closeCookieBanner");
        const acceptAll = document.getElementById("acceptAllCookies");
        const acceptNecessary = document.getElementById("acceptNecessaryCookies");

        if (!banner) return;

        // Show banner only if not accepted or dismissed
        if (!localStorage.getItem("cookieConsent") && !sessionStorage.getItem("cookieBannerDismissed")) {
            banner.classList.remove("hidden");
            setTimeout(() => banner.classList.add("show"), 10); // slide up
        }

        // Close banner (session only)
        if (closeBtn) {
            closeBtn.addEventListener("click", function () {
                sessionStorage.setItem("cookieBannerDismissed", "true");
                banner.classList.remove("show");
                setTimeout(() => banner.classList.add("hidden"), 500);
            });
        }

        // Accept all cookies
        if (acceptAll) {
            acceptAll.addEventListener("click", function () {
                localStorage.setItem("cookieConsent", JSON.stringify({
                    choice: "all",
                    date: new Date().toISOString()
                }));
                banner.classList.remove("show");
                setTimeout(() => banner.classList.add("hidden"), 500);
            });
        }

        // Accept only necessary cookies
        if (acceptNecessary) {
            acceptNecessary.addEventListener("click", function () {
                localStorage.setItem("cookieConsent", JSON.stringify({
                    choice: "necessary",
                    date: new Date().toISOString()
                }));
                banner.classList.remove("show");
                setTimeout(() => banner.classList.add("hidden"), 500);
            });
        }
    });

</script>





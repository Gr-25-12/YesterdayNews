<div id="cookieConsent"
     class="position-fixed bottom-0 start-0 w-100 shadow bg-light py-3 px-4 fade d-none"
     style="z-index: 1050;">
    <div class="container d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
        <div>
            <p class="mb-2 mb-md-0">
                At <strong class="text-primary">YesterdayNews</strong>, we use cookies to make the website work as well as possible for you.
                We also use cookies for web analytics to make the website better.
            </p>
            <a href="/Home/Privacy" class="text-decoration-underline small text-primary">
                Learn more about how YesterdayNews uses cookies
            </a>
        </div>
        <div class="d-flex gap-2">
            <button id="acceptAllCookies" class="btn btn-outline-primary">
                Yes, I agree to all cookies
            </button>
            <button id="acceptNecessaryCookies" class="btn btn-outline-primary">
                No, I only agree to necessary cookies
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const banner = document.getElementById("cookieConsent");
        const acceptAll = document.getElementById("acceptAllCookies");
        const acceptNecessary = document.getElementById("acceptNecessaryCookies");

        if (!banner) return;

        // Show banner if not accepted yet
        if (!localStorage.getItem("cookieConsent")) {
            banner.classList.remove("d-none");   // unhide
            setTimeout(() => banner.classList.add("show"), 50); // trigger fade in
        }

        // Hide with fade
        function hideBanner() {
            banner.classList.remove("show"); // triggers fade-out
            setTimeout(() => banner.classList.add("d-none"), 150); // fully hide after transition
        }

        if (acceptAll) {
            acceptAll.addEventListener("click", function () {
                localStorage.setItem("cookieConsent", JSON.stringify({
                    choice: "all",
                    date: new Date().toISOString()
                }));
                hideBanner();
            });
        }

        if (acceptNecessary) {
            acceptNecessary.addEventListener("click", function () {
                localStorage.setItem("cookieConsent", JSON.stringify({
                    choice: "necessary",
                    date: new Date().toISOString()
                }));
                hideBanner();
            });
        }
    });
</script>

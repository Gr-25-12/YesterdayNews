<div id="cookieConsent"
     class="cookie-banner position-fixed bottom-0 start-50 translate-middle-x w-100 w-md-auto shadow rounded-3 bg-light p-3 mb-3 d-none"
     style="z-index: 1050; max-width: 650px;">
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
        <div>
            <p class="mb-2">
                At <strong class="text-primary">YesterdayNews</strong>, we use cookies to make the website work as well as possible for you.
                We also use cookies for web analytics to make the website better.
            </p>
            <a href="/Home/Privacy" class="text-decoration-underline small text-primary">
                Learn more about how YesterdayNews uses cookies
            </a>
        </div>
        <div class="d-flex gap-2">
            <button id="acceptAllCookies"
                    class="btn btn-outline-primary">
                Yes, I agree to all cookies
            </button>
            <button id="acceptNecessaryCookies"
                    class="btn btn-outline-primary">
                No, I only agree to necessary cookies
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const banner = document.getElementById("cookieConsent");
        const acceptAll = document.getElementById("acceptAllCookies");
        const acceptNecessary = document.getElementById("acceptNecessaryCookies");

        if (!banner) return;

        // Show banner only if not accepted
        if (!localStorage.getItem("cookieConsent")) {
            banner.classList.remove("d-none");
            banner.classList.add("animate__animated", "animate__fadeInUp"); // optional if you load Animate.css
        }

        if (acceptAll) {
            acceptAll.addEventListener("click", function () {
                localStorage.setItem("cookieConsent", JSON.stringify({
                    choice: "all",
                    date: new Date().toISOString()
                }));
                banner.classList.add("animate__fadeOutDown");
                setTimeout(() => banner.classList.add("d-none"), 500);
            });
        }

        if (acceptNecessary) {
            acceptNecessary.addEventListener("click", function () {
                localStorage.setItem("cookieConsent", JSON.stringify({
                    choice: "necessary",
                    date: new Date().toISOString()
                }));
                banner.classList.add("animate__fadeOutDown");
                setTimeout(() => banner.classList.add("d-none"), 500);
            });
        }
    });
</script>

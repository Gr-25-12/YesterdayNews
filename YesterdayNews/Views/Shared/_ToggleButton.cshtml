@{
	bool isAdminViewingCustomer = StaticConsts.AdminView;
	var isStaff = User.IsInRole(StaticConsts.Role_Editor) || User.IsInRole(StaticConsts.Role_Journalist) || User.IsInRole(StaticConsts.Role_Admin);

}

<div class="d-flex justify-content-end ">
	@if (isAdminViewingCustomer && isStaff)
{

		<a asp-action="AdminView" asp-controller="Home"
		   class="d-flex align-items-center text-white hover-bg-secondary p-2">
			<i class="bi bi-toggles2 me-1"></i> Admin
		</a>


} 
else if (!isAdminViewingCustomer && isStaff)
{
		<a asp-action="SwitchToCustomerView" asp-controller="Home"
		   class="d-flex align-items-center text-white hover-bg-secondary p-2">
			<i class="bi bi-toggles2 me-1"></i> Customer
		</a>
}
	</div>
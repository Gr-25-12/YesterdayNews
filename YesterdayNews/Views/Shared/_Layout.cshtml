@using YesterdayNews.Models.Db
@using YesterdayNews.Services.IServices


@inject ICategoryService _categoryService

@{
	var categories = _categoryService.GetAll().OrderBy(c => c.Name).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]  YesterdayNews</title>
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/YesterdayNews.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="//cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css">
	<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
	<link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

</head>
<body>
	<header>
		<nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light my-3 w-100" style="height:70px;">
			<!-- Searchbar (Desktop) -->
			<div class="d-none d-lg-flex justify-content-start m-2" style="min-width: 200px;">
				<form asp-controller="Home" asp-action="Search" method="get" class="d-flex justify-content-end">
					<input type="text" name="query" class="form-control me-2" placeholder="Search news..." />
					<button type="submit" class="btn btn-outline-primary">
						<i class="bi bi-search"></i>
					</button>
				</form>
			</div>
			<div class="container d-flex justify-content-center align-content-center position-relative">
				<div class="d-flex flex-grow-1 justify-content-center mx-lg-4 mx-sm-0">
					<a class="navbar-brand d-flex flex-column align-items-center px-0 fw-bold text-decoration-none"
					   asp-controller="Home" asp-action="Index">
						<div class="d-flex align-items-center justify-content-center gap-3 mb-1">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="50" height="50" class="flex-shrink-0">
								<rect x="2" y="2" width="46" height="46" rx="8" fill="#3A2512" />
								<text x="15" y="36" text-anchor="middle" fill="#f8f9fa"font-weight="500" font-size="32">Y</text>
								<text x="35" y="36" text-anchor="middle" fill="#f8f9fa" font-weight="400" font-size="25">N</text>
							</svg>
							<span class="text-primary fs-3 fw-bold text-nowrap" >Yesterday's News</span>
						</div>
						<span  class="text-muted small fs-6">We bring you the news that you already know !</span>
					</a>
				</div>
				<div class="d-flex position-fixed start-0 px-2 m-2">
					<button class="navbar-toggler btn btn-outline-secondary m-1" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
							aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					
					
				</div>
					<!-- Searchbar button (visible on mobile) -->
				<div class="mobile-search-wrapper">
					<button class="btn d-lg-none btn btn-outline-primary m-1 ms-auto " type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch">
						<i class="bi bi-search"></i>
					</button>
				</div>
			</div>
			<!-- Top Navbar (including hamburger view for mobile)-->
			<div class="navbar-collapse collapse d-lg-flex justify-content-start navbar-dark bg-white text-primary m-2 ">
				<ul class="navbar-nav">
					<li class="nav-item d-lg-none">
						<a class="nav-link @(ViewData["SelectedCategory"]?.ToString() == "0" ? "active" : "")"
						asp-area="" asp-controller="Home" asp-action="Index">Home</a>
					</li>
					@foreach (var category in categories)
					{
						<li class="nav-item d-lg-none">
							<a class="nav-link @(ViewData["SelectedCategory"]?.ToString() == category.Id.ToString() ? "active" : "")"
							   asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id">
								@category.Name
							</a>
						</li>
					}
					@if (User.IsInRole(StaticConsts.Role_Admin) || User.IsInRole(StaticConsts.Role_Editor) || User.IsInRole(StaticConsts.Role_Journalist))
					{

						<li class="nav-item dropdown bg-white w-100 m-0">
							<a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Content management
							</a>
							<ul class="dropdown-menu">
								<li class="dropdown-item">
									<a class="nav-link text-dark" asp-area="" asp-controller="Article" asp-action="Index">Articles</a>
								</li>

								<li class="dropdown-item">
									<a class="nav-link text-dark" asp-area="" asp-controller="Category" asp-action="Index">Categories</a>
								</li>
								<li class="dropdown-item">
									<a class="nav-link text-dark" asp-area="" asp-controller="SubscriptionType" asp-action="Index">Subscription Types</a>
								</li>
								<li class="dropdown-item">
									<a class="nav-link text-dark" asp-area="" asp-controller="Subscription" asp-action="Index">Subscriptions</a>
								</li>
								<li><hr class="dropdown-divider"></li>
								<li><a class="dropdown-item" asp-controller="User" asp-action="Index">User Management </a></li>
							</ul>
						</li>
					}
				</ul>
				<div class="end-0 navbar-primary bg-white justify-content-end">
					<partial name="_LoginPartial" />
				</div>
			</div>

		</nav>
		<!-- bar for navigation categories -->
		<nav class="navbar navbar-expand-lg d-none d-lg-block py-0 bg-primary mt-2">
			<div class="container-fluid">
				<ul class="navbar-nav d-flex justify-content-center align-items-center w-100 fw-semibold">
					<li class="nav-item">
						<a class="nav-link text-white @(ViewData["SelectedCategory"]?.ToString() == "0" ? "active bg-secondary" : "") hover-bg-secondary"
						   asp-area="" asp-controller="Home" asp-action="Index">Home</a>
					</li>
					@foreach (var category in categories)
					{
						<li class="nav-item">
							<a class="nav-link text-white @(ViewData["SelectedCategory"]?.ToString() == category.Id.ToString() ? "active bg-secondary" : "") hover-bg-secondary"
							   asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id">
								@category.Name
							</a>
						</li>
					}
					<li class="nav-item">
						<a class="nav-link text-white hover-bg-secondary "
						   asp-controller="Externalnews" asp-action="Index">
							Outsouced News
						</a>
					</li>
				</ul>
			</div>
		</nav>
		<!-- SearchBar (Mobile only) -->
		<div class="collapse mt-2 d-lg-none mx-3 p-2 bg-primary rounded" id="mobileSearch">
			<form asp-controller="Home" asp-action="Search" method="get" class="d-flex">
				<input type="text" name="query" class="form-control me-2" placeholder="Search news..." />
				<button type="submit" class="btn btn-secondary">
					<i class="bi bi-search"></i>
				</button>
			</form>
		</div>
	</header>
	<div class="container d-flex flex-column">
		<main role="main" class="pb-3">
			<partial name="_Notification" />
			<partial name="_SubscriptionModalPartial" />
			@RenderBody()
		</main>
	</div>

	<div id="global-loader" class="global-loader">
		<div class="loader-content">
			<div class="spinner-border text-primary" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
			<div class="loader-text">Loading...</div>
		</div>
	</div>

	<footer class="footer mt-2 py-4 bg-light-subtle  border-top">
		<div class="container">
			<div class="row">
				<!-- Brand Section -->
				<div class="col-lg-4 col-md-6 mb-4 mb-md-0">
					<div class="d-flex align-items-center mb-3">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="40" height="40" class="me-2">
							<rect x="2" y="2" width="46" height="46" rx="8" fill="#3A2512" />
							<text x="15" y="36" text-anchor="middle" fill="#f8f9fa" font-weight="500" font-size="32">Y</text>
							<text x="35" y="36" text-anchor="middle" fill="#f8f9fa" font-weight="400" font-size="25">N</text>
						</svg>
						<span class="fs-5 fw-bold text-primary">Yesterday's News</span>
					</div>
					
					<div class="d-flex gap-3 col-3">
						<a href="#" class="text-secondary"><i class="bi bi-facebook fs-5"></i></a>
						<a href="#" class="text-secondary"><i class="bi bi-twitter fs-5"></i></a>
						<a href="#" class="text-secondary"><i class="bi bi-instagram fs-5"></i></a>
						<a href="#" class="text-secondary"><i class="bi bi-linkedin fs-5"></i></a>
					</div>
				</div>

				<!-- Company -->
                <div class="col-3  mb-4 mb-md-0">
					<h6 class="text-primary fw-bold mb-3">About YN</h6>
					<ul class="list-unstyled">
						
						<li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy</a></li>
						<li class="mb-2"><a href="#" class="text-muted text-decoration-none">Careers</a></li>
					</ul>
				</div>

				<!-- Newsletter -->
				<div class="col-lg-4 col-md-6">
					<h6 class="text-primary fw-bold mb-3">Stay Updated</h6>
					<p class="text-muted small mb-3">Get the latest news and be updated</p>
					<div class="input-group">
						<button type="submit" class=" btn btn-primary text-white" data-bs-toggle="modal" data-bs-target="#subscribeModal">Subscribe now please 🙏</button>
					</div>
				</div>
			</div>

			<div class="row">
				<ul class="list-inline mb-0 d-flex flex-nowrap overflow-auto">
					<li class="list-inline-item">

						<a asp-controller="Home" asp-action="Index" class="text-primary fw-bolder text-decoration-none px-3 py-2 rounded">Home</a>
					</li>
					@foreach (var category in categories)
					{
						<li class="list-inline-item">
							<a class=" text-dark @(ViewData["SelectedCategory"]?.ToString() == category.Id.ToString() ? "active bg-secondary" : "") px-3 py-2 rounded small"
							   asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id">
								@category.Name
							</a>
						</li>
					}
				</ul>
			</div>
		
			<!-- Bottom Bar -->
			<div class="row mt-4 pt-3 border-top">
				<div class="col-md-6 text-center text-md-start">
					<p class="text-muted small mb-0">
						&copy; 2025 YesterdayNews. All rights reserved.
					</p>
				</div>
				<div class="col-md-6 text-center text-md-end">
					<p class="text-muted small mb-0">
						Made with <i class="bi bi-heart-fill text-danger"></i> for news lovers
					</p>
				</div>
			</div>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
	<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="//cdn.datatables.net/2.3.2/js/dataTables.min.js" asp-append-version="true"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
	<script src="https://cdn.tiny.cloud/1/gqsdnvz8tyyms509u45t3zxlbfubgjtak1sdup901qv1tl9g/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/SubscriptionsModal.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@using YesterdayNews.Models.Db
@using YesterdayNews.Services.IServices
@using Microsoft.AspNetCore.Mvc.Controllers


<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]  YesterdayNews</title>
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/YesterdayNews.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="//cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css">
	<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
	<link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

</head>
<body>
	<header>
		<nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light my-3 w-100" style="height:70px;">
			<!-- Searchbar (Desktop) -->
			<div class="d-none d-lg-flex justify-content-start m-2" style="min-width: 200px;">
				<form asp-controller="Home" asp-action="Search" method="get" class="d-flex justify-content-end">
					<input type="text" name="query" class="form-control me-2" placeholder="Search news..." />
					<button type="submit" class="btn btn-outline-primary">
						<i class="bi bi-search"></i>
					</button>
				</form>
			</div>
			<div class="container d-flex justify-content-center align-content-center position-relative">
				<partial name="_Logo"/>

				@* Burger menu *@
				<div class="d-flex position-fixed start-0 px-2 m-2">
					<button class="navbar-toggler btn btn-outline-secondary m-1" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
					aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>


				</div>
				<!-- Searchbar button (visible on mobile) -->
				<div class="mobile-search-wrapper">
					<button class="btn d-lg-none btn btn-outline-primary m-1 ms-auto " type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch">
						<i class="bi bi-search"></i>
					</button>
				</div>
			</div>
			<!-- Top Navbar (including hamburger view for mobile)-->

			<div class="navbar-collapse collapse d-lg-flex justify-content-start navbar-dark bg-white text-primary m-2 ">
				<partial name="_NavBarMobile" />
				<div class="end-0 navbar-primary bg-white justify-content-end">
					<partial name="_LoginPartial" />
				</div>
			</div>
		</nav>
		
		<partial name="_NavBar"/>
		<!-- SearchBar (Mobile only) -->
		<div class="collapse mt-2 d-lg-none mx-3 p-1 bg-primary rounded @(currentAction == "Search" ? "show" : "")" id="mobileSearch">
			<form asp-controller="Home" asp-action="Search" method="get" class="d-flex flex-column">
				<div class="d-flex mb-1">
					<input type="text" name="query" class="form-control me-2" placeholder="Search news..." />
					<button type="submit" class="btn btn-secondary">
						<i class="bi bi-search"></i>
					</button>
				</div>
				<div class="d-flex align-items-center">
						<div class="form-check ms-2">
							<input class="form-check-input custom-radio" type="radio" name="archived" value="false" id="publishedRadio" @(archived ? "" : "checked") />
							<label class="form-check-label text-white" for="publishedRadio">
								Published
							</label>
						</div>
						<div class="form-check ms-2">
							<input class="form-check-input custom-radio" type="radio" name="archived" value="true" id="archivedRadio" @(archived ? "checked" : "") />
							<label class="form-check-label text-white" for="archivedRadio">
								Archived
							</label>
						</div>
					</div>
			</form>
		</div>
	</header>
	<div class="container d-flex flex-column" style="margin-bottom:170px">
		<main role="main" class="pb-3">
			<partial name="_Notification" />
			<partial name="_SubscriptionModalPartial" />
			@RenderBody()
		</main>
	</div>

	<partial name="_Spinner"/>

	<partial name="_Footer" />
	
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
	<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="//cdn.datatables.net/2.3.2/js/dataTables.min.js" asp-append-version="true"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
	<script src="https://cdn.tiny.cloud/1/gqsdnvz8tyyms509u45t3zxlbfubgjtak1sdup901qv1tl9g/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/SubscriptionsModal.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)


	
</body>


</html>

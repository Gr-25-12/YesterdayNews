@using YesterdayNews.Models.Db
@using YesterdayNews.Services.IServices
@using Microsoft.AspNetCore.Mvc.Controllers

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<!-- Primary Meta Tags -->
	<meta name="description" content="Yesterday's News - We bring you the news that you already know! Stay updated with the latest news from your favorite authors.">
	<meta name="keywords" content="news, articles, latest news, yesterday news, current events">
	<meta name="author" content="YesterdayNews">
	<meta name="robots" content="index, follow">
	<link rel="apple-touch-icon" sizes="180x180" href="~/fav.png">
	<link rel="icon" type="image/png" sizes="32x32" href="~/fav.png">
	<link rel="icon" type="image/png" sizes="16x16" href="~/fav.png">
	<link rel="manifest" href="~/favicon/site.webmanifest">
	<link rel="mask-icon" href="~/fav.png" color="#5bbad5">
	<meta name="msapplication-TileColor" content="#da532c">
	<meta name="theme-color" content="#ffffff">

	<title>@ViewData["Title"]  YesterdayNews</title>
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/YesterdayNews.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="//cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css">
	<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
	<link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

</head>
<body>
	<header class="border-bottom border-1 position-sticky top-0 z-3 bg-white shadow-sm">
		<nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light my-3 w-100 " style="height:70px;">
			 <div class="d-flex justify-content-center align-items-center w-100">
					
				<partial name="_SearchBar" />
				

				<div class="container d-flex justify-content-center align-content-center  border-4">
					<partial name="_Logo"/>
					<partial name="_BurgerMenu" />
					<div class="d-flex position-fixed end-0 px-2 m-2 z-1">
						<button class="btn d-lg-none btn btn-outline-primary m-1 ms-auto " type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch">
							<i class="bi bi-search"></i>
						</button>
					</div>

				</div>
			
				<div class="navbar-collapse collapse text-primary m-2">
					<partial name="_NavBarMobile" />
					<div class="end-0 navbar-primary bg-white justify-content-end">
						<partial name="_LoginPartial" />
					</div>
			</div>
		</div> 
			
		</nav>
		<partial name="_NavBar"/>
		<partial name="_SearchBarMobile" />
		
	</header>
	<div class="container d-flex flex-column" style="margin-bottom:170px">
		<main role="main" class="pb-3">
			<partial name="_Notification" />
			<partial name="_SubscriptionModalPartial" />
			@RenderBody()
		</main>
	</div>

	<partial name="_Spinner"/>

	<partial name="_Footer" />
	
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
	<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="//cdn.datatables.net/2.3.2/js/dataTables.min.js" asp-append-version="true"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
	<script src="https://cdn.tiny.cloud/1/gqsdnvz8tyyms509u45t3zxlbfubgjtak1sdup901qv1tl9g/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
	<script src="~/js/WeatherApi.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/SubscriptionsModal.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)


	
</body>


</html>

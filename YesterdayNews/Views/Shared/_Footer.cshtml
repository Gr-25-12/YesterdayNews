@using YesterdayNews.Services.IServices
@inject ICategoryService _categoryService

@{
	var categories = _categoryService.GetAll().OrderBy(c => c.Name).ToList();
	bool isAdminViewingCustomer = (StaticConsts.AdminView && 
		(User.IsInRole(StaticConsts.Role_Admin) || User.IsInRole(StaticConsts.Role_Editor) || User.IsInRole(StaticConsts.Role_Journalist)))
		|| !User.IsInRole(StaticConsts.Role_Admin);
}


@if (isAdminViewingCustomer)
{
	<footer class="footer mt-auto py-4 bg-white border-top">
		<div class="container">
			<div class="row">
				<!-- Brand Section -->
				<div class="col-lg-4 col-md-6 mb-4 mb-md-0">
					<div class="d-flex align-items-center mb-3">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="40" height="40" class="me-2">
							<rect x="2" y="2" width="46" height="46" rx="8" fill="#3A2512" />
							<text x="15" y="36" text-anchor="middle" fill="#f8f9fa" font-weight="500" font-size="32">Y</text>
							<text x="35" y="36" text-anchor="middle" fill="#f8f9fa" font-weight="400" font-size="25">N</text>
						</svg>
						<span class="fs-5 fw-bold text-primary">Yesterday's News</span>
					</div>

					<div class="d-flex gap-3">
						<a href="#" class="text-secondary"><i class="bi bi-facebook fs-5"></i></a>
						<a href="#" class="text-secondary"><i class="bi bi-twitter fs-5"></i></a>
						<a href="#" class="text-secondary"><i class="bi bi-instagram fs-5"></i></a>
						<a href="#" class="text-secondary"><i class="bi bi-linkedin fs-5"></i></a>
					</div>
				</div>

				<!-- Company -->
				<div class="col-md-3 col-6 mb-4 mb-md-0">
					<h6 class="text-primary fw-bold mb-3">About YN</h6>
					<ul class="list-unstyled">
						<li class="mb-2"><a asp-controller="Home" asp-action="Search" asp-route-archived="true" class="text-muted text-decoration-none">Archived News</a></li>
						<li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy</a></li>
						<li class="mb-2"><a href="#" class="text-muted text-decoration-none">Careers</a></li>
					</ul>
				</div>

				<!-- Newsletter -->
				<div class="col-lg-4 col-md-6">
					<h6 class="text-primary fw-bold mb-3">Stay Updated</h6>
					<p class="text-muted small mb-3">Get the latest news and be updated</p>
					<div class="input-group">
						<button type="submit" class="btn btn-primary text-white">Subscribe now please 🙏</button>
					</div>
				</div>
			</div>

			<div class="row mt-4">
				<div class="col-12">
					<div class="d-flex overflow-auto">
						<div class="d-flex flex-nowrap">
							<ul class="list-inline mb-0 d-flex flex-nowrap overflow-hidden">
								<li class="list-inline-item">

									<a asp-controller="Home" asp-action="Index" class="text-primary fw-bolder text-decoration-none px-3 py-2 rounded ">Home</a>
								</li>
								@foreach (var category in categories)
								{
									<li class="list-inline-item">
										<a class=" text-dark @(ViewData["SelectedCategory"]?.ToString() == category.Id.ToString() ? "active bg-secondary" : "") px-3 py-2 rounded small"
										   asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id">
											@category.Name
										</a>
									</li>
								}
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- Bottom Bar -->
			<div class="row mt-4 pt-3 border-top">
				<div class="col-md-6 text-center text-md-start">
					<p class="text-muted small mb-0">
						&copy; 2025 YesterdayNews. All rights reserved.
					</p>
				</div>
				<div class="col-md-6 text-center text-md-end">
					<p class="text-muted small mb-0">
						Made with <i class="bi bi-heart-fill text-danger"></i> for news lovers
					</p>
				</div>
			</div>
		</div>
	</footer>
}